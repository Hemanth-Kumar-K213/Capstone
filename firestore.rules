rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }


    // ============================================================
    // USER PROFILES
    // users/{authUid}
    // ============================================================

    match /users/{userId} {

      // A user can read only their own profile, or a connected trusted contact can read if a relationship exists.
      allow read: if isSignedIn()
                  && (
                    request.auth.uid == userId
                    || exists(/databases/$(database)/documents/relationships/$(userId + '_' + request.auth.uid))
                  );

      // User creates only their own USER profile.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.authUserId == userId
                    && request.resource.data.accountType == 'USER';

      // User can update only their own profile.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && resource.data.authUserId == userId
                    && request.resource.data.authUserId == userId
                    && request.resource.data.accountType == 'USER';

      // Client cannot delete profiles.
      allow delete: if false;
    }


    // ============================================================
    // TRUSTED CONTACT PROFILES
    // trustedContacts/{authUid}
    // ============================================================

    match /trustedContacts/{tcId} {

      // Trusted contact can access only their own profile, or connected user can read if relationship exists.
      allow read: if isSignedIn()
                  && (
                    request.auth.uid == tcId
                    || exists(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + tcId))
                  );

      // Trusted contact creates only their own profile.
      allow create: if isSignedIn()
                    && request.auth.uid == tcId
                    && request.resource.data.authUserId == tcId
                    && request.resource.data.accountType == 'TRUSTED_CONTACT';

      // Trusted contact can update only their own profile.
      allow update: if isSignedIn()
                    && request.auth.uid == tcId
                    && resource.data.authUserId == tcId
                    && request.resource.data.authUserId == tcId
                    && request.resource.data.accountType == 'TRUSTED_CONTACT';

      // Client cannot delete profiles.
      allow delete: if false;
    }


    // ============================================================
    // WEEKLY UID
    //
    // IMPORTANT:
    // Document ID should be the actual weekly UID.
    //
    // Example:
    // weeklyUids/202608181234
    //
    // The client can READ one specific UID document.
    // The client can NEVER create/update/delete UID documents.
    // Cloud Functions/Admin SDK handles UID creation and rotation.
    // ============================================================

    match /weeklyUids/{weeklyUid} {

      // Retrieve a specific UID document if exact UID is known.
      allow get: if true;

      // No collection-wide listing.
      // No client writes.
      allow list: if false;
      allow create, update, delete: if false;
    }


    // ============================================================
    // RELATIONSHIPS
    //
    // IMPORTANT:
    // Use a deterministic document ID:
    //
    // {userId}_{trustedContactId}
    //
    // Example:
    // relationships/userFirebaseUid_trustedContactFirebaseUid
    //
    // This allows security rules to verify the relationship
    // without exposing the whole relationship collection.
    // ============================================================

    match /relationships/{relationshipId} {

      // User or trusted contact can read ONLY their own relationship.
      allow read: if isSignedIn()
                  && (
                    resource.data.userId == request.auth.uid
                    || resource.data.trustedContactId == request.auth.uid
                  );


      // Trusted contact creates a PENDING request.
      allow create: if isSignedIn()
                    && request.resource.data.trustedContactId == request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    && request.resource.data.userId != request.auth.uid
                    && relationshipId ==
                       request.resource.data.userId + "_" +
                       request.resource.data.trustedContactId;


      // User can approve / deny / revoke. Trusted contact can also revoke or cancel their relationship.
      allow update: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || resource.data.trustedContactId == request.auth.uid)

                    // Relationship identities cannot be changed.
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.trustedContactId ==
                       resource.data.trustedContactId

                    // Only valid relationship states.
                    && request.resource.data.status
                       in ['APPROVED', 'DENIED', 'REVOKED', 'PENDING']

                    // Relationship ID remains deterministic.
                    && relationshipId ==
                       request.resource.data.userId + "_" +
                       request.resource.data.trustedContactId;



      // User or trusted contact can delete their own relationship.
      allow delete: if isSignedIn()
                    && (
                      resource.data.userId == request.auth.uid
                      || resource.data.trustedContactId == request.auth.uid
                    );
    }


    // ============================================================
    // DEV UID MAPPINGS (Spark/Free plan fallback)
    //
    // IMPORTANT:
    // This collection is used ONLY when Cloud Functions are not
    // deployed (Spark plan). When Cloud Functions are available
    // (Blaze plan), the weeklyUids collection is used instead.
    //
    // Document ID = the UID value (e.g., devUidMappings/202608181234)
    //
    // Security:
    // - Only the owner (userId == auth.uid) can create/update
    // - Any authenticated user can read by document ID (for TC lookup)
    // - No collection-wide listing
    // - Cannot write mappings for other users
    // ============================================================

    match /devUidMappings/{uid} {

      // Any user or website with the specific UID can look up the mapping.
      allow get: if true;

      // No collection-wide listing.
      allow list: if false;

      // Only the owner can create their own UID mapping.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.uid == uid;

      // Only the owner can update their own UID mapping.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.uid == uid;

      // No deletion.
      allow delete: if false;
    }


    // ============================================================
    // USER LOCATIONS
    // userLocations/{userId}/locations/{locationId}
    // ============================================================

    match /userLocations/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /locations/{locationId} {
        // User can write their own locations
        allow write: if isSignedIn() && request.auth.uid == userId;
        // User and authenticated contacts can read
        allow read: if isSignedIn();
      }
    }


    // ============================================================
    // CHILD LOCATIONS (Dedicated for Website & App Tracking by UID)
    // child_locations/{uid} & uid_locations/{uid}
    // Updated every 10 seconds.
    // ============================================================

    match /child_locations/{uid} {
      // Authenticated mobile app user can update their location
      allow write: if isSignedIn();

      // Anyone with the child's rotating UID (website or app) can track their live location
      allow read: if true;

      match /history/{historyId} {
        allow write: if isSignedIn();
        allow read: if true;
      }
    }

    match /uid_locations/{uid} {
      allow write: if isSignedIn();
      allow read: if true;

      match /history/{historyId} {
        allow write: if isSignedIn();
        allow read: if true;
      }
    }


    // ============================================================
    // SOS EVENTS
    // sosEvents/{eventId}
    // ============================================================

    match /sosEvents/{eventId} {
      // User can create their own SOS event
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // User who created the SOS or authenticated participants can update/resolve
      allow update: if isSignedIn();

      // Authenticated users (User and approved Trusted Contacts) can read SOS events
      allow read: if isSignedIn();

      // No deletion
      allow delete: if false;
    }


    // ============================================================
    // RISK EVENTS
    // riskEvents/{eventId}
    // ============================================================

    match /riskEvents/{eventId} {
      // User can create their own Risk event
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // User who created the Risk event can update it
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid;

      // User can read their own Risk events
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;

      // No deletion
      allow delete: if false;
    }


    // ============================================================
    // JOURNEYS
    // journeys/{journeyId}
    // ============================================================

    match /journeys/{journeyId} {
      // User can create their own journey log
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // User can update/read their own journey log
      allow update, read: if isSignedIn()
                          && resource.data.userId == request.auth.uid;

      // No deletion
      allow delete: if false;
    }


    // ============================================================
    // OTPS (2FACTOR SMS VERIFICATION)
    // otps/{phoneNumber}
    // ============================================================

    match /otps/{phoneNumber} {
      // Only Cloud Functions via Firebase Admin SDK can create/update/read OTP records.
      // All client reads and writes are denied to prevent credential leakage or spoofing.
      allow read, write: if false;
    }


    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }
  }
}